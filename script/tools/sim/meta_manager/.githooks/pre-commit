set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

mapfile -d '' -t staged_files < <(
    git diff --cached --name-only --diff-filter=d --relative -z
)

bash format.sh

if [ "${#staged_files[@]}" -gt 0 ]; then
    git add -- "${staged_files[@]}"
fi
